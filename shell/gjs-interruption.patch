+/**
+ * gjs_context_tgnome_mark_interrupt: (skip)
+ * @self: the embedding context
+ *
+ * Private experiment: called on the JS thread by an embedding's deliberate
+ * interrupt hook, immediately before returning false. Never marks OOM or
+ * system.exit(). Rejects nested, job and module entries. The embedding owns
+ * the outer native dispatch boundary and must honor a FALSE result.
+ */
+gboolean gjs_context_tgnome_mark_interrupt(GjsContext* self) {
+    g_return_val_if_fail(GJS_IS_CONTEXT(self), FALSE);
+    auto* gjs = GjsContextPrivate::from_object(self);
+    if (!gjs->is_owner_thread() || !gjs->tgnome_interrupt_permitted() ||
+        g_object_get_data(G_OBJECT(self), "tgnome-protected-scope-depth") ||
+        g_object_get_data(G_OBJECT(self), "tgnome-protection-fault") ||
+        g_object_get_data(G_OBJECT(self), "tgnome-explicit-interrupt"))
+        return FALSE;
+    g_object_set_data(G_OBJECT(self), "tgnome-explicit-interrupt", GINT_TO_POINTER(1));
+    return TRUE;
+}
+
+/**
+ * gjs_context_tgnome_take_interrupt: (skip)
+ * @self: the embedding context
+ *
+ * Consume exactly one explicit-interruption marker. Native synchronous eval
+ * callers must consume unused markers after eval returns.
+ */
+gboolean gjs_context_tgnome_take_interrupt(GjsContext* self) {
+    g_return_val_if_fail(GJS_IS_CONTEXT(self), FALSE);
+    return g_object_steal_data(G_OBJECT(self), "tgnome-explicit-interrupt") != nullptr;
+}
+
+/**
+ * gjs_context_tgnome_protect_scope: (skip)
+ * @self: the embedding context
+ * @entering: push rather than pop a protected native ownership scope
+ *
+ * The embedding brackets operations whose JS finally must run. Only the owner
+ * thread may mutate this counter. An invalid pop/overflow leaves it unchanged.
+ */
+gboolean gjs_context_tgnome_protect_scope(GjsContext* self, gboolean entering) {
+    g_return_val_if_fail(GJS_IS_CONTEXT(self), FALSE);
+    if (!GjsContextPrivate::from_object(self)->is_owner_thread())
+        return FALSE;
+    guint depth = GPOINTER_TO_UINT(g_object_get_data(
+        G_OBJECT(self), "tgnome-protected-scope-depth"));
+    if ((entering && depth == G_MAXUINT) || (!entering && depth == 0))
+        return FALSE;
+    depth = entering ? depth + 1 : depth - 1;
+    g_object_set_data(G_OBJECT(self), "tgnome-protected-scope-depth",
+                      GUINT_TO_POINTER(depth));
+    return TRUE;
+}
+
+/**
+ * gjs_context_tgnome_protected_depth: (skip)
+ * @self: the embedding context
+ *
+ * Returns: the owner-thread scope depth, or G_MAXUINT for an invalid caller
+ */
+guint gjs_context_tgnome_protected_depth(GjsContext* self) {
+    g_return_val_if_fail(GJS_IS_CONTEXT(self), G_MAXUINT);
+    if (!GjsContextPrivate::from_object(self)->is_owner_thread())
+        return G_MAXUINT;
+    return GPOINTER_TO_UINT(g_object_get_data(
+        G_OBJECT(self), "tgnome-protected-scope-depth"));
+}
